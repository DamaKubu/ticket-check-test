#!/bin/sh
# Blocks a push when:
#   - it goes straight to main/master (changes must go through a PR),
#   - the branch name has no ticket key (e.g. DBOX-1023-fix-map),
#   - any new commit's subject doesn't start with a ticket key.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>

remote="$1"
ticket_re='[A-Z][A-Z0-9]+-[0-9]+'
zero=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a branch, or pushing tags: nothing to check.
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

  branch=${remote_ref#refs/heads/}

  case "$branch" in
    main|master)
      echo "pre-push: don't push straight to '$branch' — push your ticket branch and open a PR." >&2
      fail=1
      continue
      ;;
  esac

  if ! printf '%s' "$branch" | grep -qiE "$ticket_re"; then
    echo "pre-push: branch '$branch' has no ticket. Create it from Jira, e.g. DBOX-1023-fix-map" >&2
    echo "  rename it with:  git branch -m DBOX-xxxx-$branch" >&2
    fail=1
    continue
  fi

  # Only commits the remote doesn't have yet.
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086
  untagged=$(git log --no-merges --format='%h %s' $range | grep -vE "^[0-9a-f]+ ($ticket_re|Revert )")
  if [ -n "$untagged" ]; then
    echo "pre-push: these commits on '$branch' don't start with a ticket:" >&2
    printf '%s\n' "$untagged" | sed 's/^/    /' >&2
    echo "  fix the last one with:  git commit --amend   (the commit-msg hook adds the ticket)" >&2
    echo "  fix older ones with:    git rebase -i --exec 'git commit --amend --no-edit' origin/main" >&2
    fail=1
  fi
done

exit $fail
